@model string
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
@switch (Model)
{
    case "heart":
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
        break;
    case "chip":
        <rect x="5" y="5" width="14" height="14" rx="3" /><rect x="9" y="9" width="6" height="6" rx="1" />
        <path d="M9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3M19 9h3m-3 6h3" />
        break;
    case "lock":
        <rect x="5" y="10" width="14" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" />
        break;
    case "arrow":
        <path d="M4 12h16m-6-6 6 6-6 6" />
        break;
    case "check":
        <path d="m5 12 4 4L19 6" />
        break;
    case "close":
        <path d="m6 6 12 12M6 18 18 6" />
        break;
    case "bulb":
        <path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z" />
        break;
    case "trophy":
        <path d="M8 3h8v6a4 4 0 0 1-8 0V3Zm0 2H4v2a4 4 0 0 0 4 4m8-6h4v2a4 4 0 0 1-4 4m-4 2v5m-4 3h8m-6-3h4" />
        break;
    case "game":
        <path d="M8 7h8a5 5 0 0 1 5 4l1 6a2 2 0 0 1-3 2l-4-3H9l-4 3a2 2 0 0 1-3-2l1-6a5 5 0 0 1 5-4Z" />
        <path d="M7 10v4m-2-2h4m6-1h.01M18 13h.01" />
        break;
    case "layers":
        <path d="m12 3 10 5-10 5L2 8l10-5Zm-10 9 10 5 10-5M2 16l10 5 10-5" />
        break;
    default:
        <circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" />
        break;
}
</svg>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6451ce" />

    <title>@ViewData["Title"] · Bilgisayar Akademisi</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#ana-icerik">
        İçeriğe geç
    </a>

    <header class="site-header">
        <div class="header-inner">

            <a class="brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Bilgisayar Akademisi ana sayfa">

                <span class="brand-icon">
                    <partial name="_Icon" model='@("chip")' />
                </span>

                <span>
                    BİLGİSAYAR
                    <span class="brand-second">
                        AKADEMİSİ<span class="brand-dot">.</span>
                    </span>
                </span>
            </a>

            <nav class="main-nav" aria-label="Ana menü">

                <a asp-controller="Home" asp-action="Index">
                    Ana sayfa
                </a>

                <a asp-controller="Egitim"
                   asp-action="Index"
                   class="nav-study">

                    Öğrenme yolum
                    <partial name="_Icon" model='@("arrow")' />
                </a>

            </nav>
        </div>
    </header>

    <main id="ana-icerik" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>Bilgisayar Akademisi</span>
        <span>Keşfet. Dene. Öğren.</span>
    </footer>

    <script src="~/js/site.js"
            asp-append-version="true"
            defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>